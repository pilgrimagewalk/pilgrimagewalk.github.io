<!DOCTYPE html>

<!--
    To test language translations locally, use:
    <html lang="en" data-test-lang="fr"> etc

    cs - Czech         lt - Lithuanian
    da - Danish        mt - Maltese
    de - German        nl - Dutch
    el - Greek         pl - Polish
    en - English       pt - Portuguese
    es - Spanish       ro - Romanian
    fr - French        sk - Slovak
    hr - Croatian      sl - Slovenian
    hu - Hungarian     sv - Swedish
    it - Italian       uk - Ukrainian
    bg - Bulgarian     sr - Serbian

    et - Estonian
    fi - Finnish
    lv - Latvian
    no - Norwegian
    tr - Turkish
-->

<!-- TEST LANGUAGE (temporary)-->
<!-- <html lang="en" data-test-lang="de"> -->

<!-- ENGLISH DEFAULT -->
<html lang="en">

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <link rel="canonical" href="https://pilgrimagewalk.eu/">
        <meta name="author" content="Enda F" />
        <meta name="description" content="A personal walking pilgrimage across
        Europe, visiting the great Marian shrines along ancient pilgrim paths." />

        <title>European Pilgrimage</title>
        <link rel="icon" type="image/x-icon" href="assets/favicon.ico" />

        <!-- Core theme CSS (includes Bootstrap)-->
        <link href="css/styles.css" rel="stylesheet" />

        <!-- Fontello icon font CSS -->
        <link href="css/fontello.css" rel="stylesheet">

    </head>


    <body id="page-top">

        <header class="masthead text-left text-white">

            <div class="masthead-content">
                <div class="container px-2">
                    <h2 class="masthead-heading mb-0" data-i18n="masthead_title" data-i18n-lines="words">European Walking Pilgrimage</h2>
                </div>
            </div>

        </header>

        <section id="About" class="py-5">
        <div class="container px-4 px-lg-5">
        <div class="row gx-4 align-items-stretch">


        <div class="col-md-3">
            <div class="h-100 rounded shadow overflow-hidden">
            <img
                src="/assets/img/portrait.webp"
                alt="Portrait"
                class="w-100 h-100"
                style="object-fit: cover;"
            />
            </div>
        </div>


        <div class="col-md-9">
            <div class="ratio ratio-4x3 rounded overflow-hidden border shadow-sm position-relative bg-light">
            <img
                src="/assets/img/map-preview.webp"
                alt="Preview of the pilgrimage route map"
                class="ratio-item"
                style="object-fit: cover;"
                loading="lazy"
                decoding="async"
            >

            <div
                class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
                style="background: transparent; z-index: 2;"
            >
                <button
                type="button"
                class="btn btn-primary px-4 py-2"
                id="loadMapBtn"
                data-i18n="view_current_location"
                aria-label="View current location"
                style="width: auto; height: auto;"
                >
                View Current Location
                </button>
            </div>
            </div>

            <div
            class="ratio ratio-4x3 rounded overflow-hidden border shadow-sm d-none position-relative bg-light"
            id="mapFrameWrap"
            >
            <iframe
                title="Pilgrimage route map"
                id="mapFrame"
                data-src="https://www.google.com/maps/d/u/1/embed?mid=129433ybTJqXHOs-b_ZfS3I4_tRbnLVk&ehbc=2E312F"
                style="border:0;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>

            <div
                id="mapLoadingIndicator"
                class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center bg-light"
                aria-live="polite"
                aria-label="Loading map"
                style="z-index: 1;"
            >
                <div class="spinner-border text-primary mb-2" role="status" aria-hidden="true"></div>
                <span>Loading map...</span>
            </div>
            </div>

        </div>
        </div>
        </div>
        </section>



        <section id="Background" class="py-3">
            <div class="container px-4 px-lg-5">
                <div class="row gx-5 align-items-center">

                    <div class="col-md-7">
                        <div class="p-1"><img class="img-fluid rounded earthy-img" src="assets/img/shrine.webp" alt="..." /></div>
                    </div>

                    <div class="col-md-5">
                            <h3 class="display-4" data-i18n="pilgrimage_title">Pilgrimage</h3>
                            <p data-i18n="pilgrimage_p1"> </p>
                            <p data-i18n="pilgrimage_p2"> </p>
                    </div>

                </div>
            </div>
        </section>


        <section id="walking" >
        <div class="container px-4 px-lg-5">
            <div class="row gx-3">
            <div class="col-md-4">
                <div class="ratio ratio-1x1 mb-3" style="margin-top: 0.5rem;">
                <img
                    src="assets/img/walking-1.jpg"
                    alt="Walking pilgrimage view"
                    class="img-fluid rounded shadow earthy-img"
                    style="object-fit: cover;"
                />
                </div>
            </div>
            <div class="col-md-4">
                <div class="ratio ratio-1x1 mb-3" style="margin-top: 0.5rem;">
                <img
                    src="assets/img/walking-4-old.jpg"
                    alt="Pilgrim route scene"
                    class="img-fluid rounded shadow earthy-img"
                    style="object-fit: cover;"
                />
                </div>
            </div>
            <div class="col-md-4">
                <div class="ratio ratio-1x1 mb-3" style="margin-top: 0.5rem;">
                <img
                    src="assets/img/walking-3.jpg"
                    alt="Pilgrimage on the road"
                    class="img-fluid rounded shadow earthy-img"
                    style="object-fit: cover;"
                />
                </div>
            </div>
            </div>
        </div>
        </section>


<section id="shrines" class="py-5">
  <div class="container px-4 px-lg-5">
    <h2 class="display-4 text-center mb-5" data-i18n="european_marian_network_heading">
      European Marian Network
    </h2>

    <div class="row g-4 align-items-start">
      <!-- Left: map -->
      <div class="col-12 col-lg-7">
        <div class="shrines-map-card shrines-sticky">
          <img src="assets/img/Marian-Network-Color.webp"
               alt="European Marian Network Map"
               class="shrines-map-img">
        </div>
      </div>

      <!-- Right: list -->
      <div class="col-12 col-lg-5">
        <div class="shrines-list-card">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <h3 class="h5 mb-0">Shrines</h3>
            <span class="text-muted small">21</span>
          </div>

          <div class="shrines-list" aria-label="Shrines list">
            <!-- Convert each chip to a list item style link -->
            <a class="shrine-row" href="https://www.knockshrine.ie/" target="_blank" rel="noopener noreferrer">
              <img class="flag" src="assets/img/flags/ie.webp" alt="Ireland flag" width="30" height="22">
              <span class="shrine-name">Knock</span>
              <span class="shrine-ext" aria-hidden="true">↗</span>
            </a>

            <a class="shrine-row" href="https://www.walsingham.org.uk" target="_blank" rel="noopener noreferrer">
              <img class="flag" src="assets/img/flags/gb.webp" alt="UK flag" width="30" height="22">
              <span class="shrine-name">Walsingham</span>
              <span class="shrine-ext" aria-hidden="true">↗</span>
            </a>

            <!-- ...repeat for the rest... -->
          </div>
        </div>
      </div>
    </div>
  </div>
</section>




        <section id="on-the-road" class="on-road-panel py-5">
            <div class="container px-4 px-lg-5">
                <h2 class="display-4 text-center mb-5" data-i18n="on_the_road_heading">On the Road</h2>
                <div class="on-road-collage" aria-label="Collage of pilgrimage photos from the road">
                    <figure class="collage-item">
                        <img src="assets/img/logo-franci.jpg" alt="Via Francigena logo" loading="lazy" decoding="async" />
                    </figure>
                    <figure class="collage-item">
                        <img src="assets/img/Pilgrim-1-2024.jpg" alt="Pilgrim photo from 2024" loading="lazy" decoding="async" />
                    </figure>

                    <figure class="collage-item wide">
                        <img src="assets/img/Francigena.jpg" alt="Francigena route view" loading="lazy" decoding="async" />
                    </figure>
                    <figure class="collage-item big">
                        <img src="assets/img/jasna-gora-2021.jpg" alt="Poland" loading="lazy" decoding="async" />
                    </figure>
                    <figure class="collage-item">
                        <img src="assets/img/Labre-Monaghan.jpg" alt="Labre-Monaghan pilgrimage moment" loading="lazy" decoding="async" />
                    </figure>
                    <figure class="collage-item">
                        <img src="assets/img/butterfly.jpg" alt="Butterfly seen on the road" loading="lazy" decoding="async" />
                    </figure>

                    <!-- special styling -->
                    <figure id="kofi-card" class="collage-item wide">
                    <a href="https://ko-fi.com/V7V01RJ83L" target="_blank" rel="noopener">
                        <img
                        src="assets/img/kofi-support.jpg"
                        alt="Follow the Walk"
                        loading="lazy"
                        decoding="async"
                        />
                    </a>
                    <style>
                        /* default: force nearly full color for this one image */
                        #kofi-card img {
                        filter: grayscale(100%) !important;
                        /* transition: filter 0.35s ease; */
                        transition: filter 0.08s ease !important;
                        }
                        /* hover/focus: only 50% grayscale (i.e., partial color) */
                        #kofi-card a:hover img,
                        #kofi-card a:focus img,
                        #kofi-card a:focus-visible img {
                        filter: grayscale(0%) !important;
                        }

                    </style>
                    </figure>

                    <figure class="collage-item wide">
                        <img src="assets/img/Shrines1.jpg" alt="Shrines visited during the pilgrimage" loading="lazy" decoding="async" />
                    </figure>


                    <figure class="collage-item tall">
                        <img src="assets/img/Benedict2.webp" alt="Pilgrim portrait on the journey" loading="lazy" decoding="async" />
                    </figure>
                    <figure class="collage-item tall">
                        <img src="assets/img/cycle-to-Poland-camino-sign.jpg" alt="Camino sign on route to Poland" loading="lazy" decoding="async" />
                    </figure>
                    <figure class="collage-item">
                        <img src="assets/img/logo-Camino.jpg" alt="Camino logo" loading="lazy" decoding="async" />
                    </figure>
                    <figure class="collage-item">
                        <img src="assets/img/camino3.webp" alt="Camino route sign" loading="lazy" decoding="async" />
                    </figure>
                    <figure class="collage-item wide">
                        <img src="assets/img/dreams.webp" alt="dreams" loading="lazy" decoding="async" />
                    </figure>
                    <figure class="collage-item">
                        <img src="assets/img/Pilgrim-2-2024.jpg" alt="Second pilgrim photo from 2024" loading="lazy" decoding="async" />
                    </figure>
                    <figure class="collage-item">
                        <img src="assets/img/camp.jpg" alt="Pilgrim campsite" loading="lazy" decoding="async" />
                    </figure>
                </div>
            </div>
        </section>


        <!-- <p class="footer-text mb-2">&copy; <span id="currentYear">2026</span> Enda </p> -->


        <footer class="site-footer py-5 bg-dark">
        <div class="container px-4 px-lg-5">
            <div class="row g-1 align-items-center">


            <!-- <div class="col-md-2 text-md-end"> -->
            <div class="col-md-auto">
                <a href="https://revolut.me/farrelle"
                target="_blank" rel="noopener noreferrer"
                class="revolut-link"
                aria-label="Support via Revolut (opens Revolut link)">
                <img src="/assets/img/Revolut-qr-tan.jpg"
                    alt="Revolut QR code"
                    class="revolut-qr">
                </a>

            </div>

            <!-- <div class="col-md-7 text-md-left"> -->
            <div class="col text-md-start">
                <p class="footer-title mb-2" data-i18n="masthead_title">European Pilgrimage</p>
                <p class="footer-text mb-2" data-i18n="footer_tagline">Walking ancient paths &amp; visiting Marian shrines</p>
                <p class="footer-meta mb-1"> <a href="mailto:europilgrimage@gmx.com">✉ europilgrimage@gmx.com</a> </p>
            </div>


            <div class="col-md-3 text-md-end">
                <p class="footer-title mb-2" data-i18n="support_title">Support</p>
                <a href="https://ko-fi.com/V7V01RJ83L"
                target="_blank" rel="noopener noreferrer"
                class="kofi-link rounded-pill"
                aria-label="Support via Ko-fi">
                <span class="kofi-icon" aria-hidden="true">☕</span>
                <span data-i18n="buy_me_a_coffee">Buy me a coffee</span>
                </a>
            </div>


        </div>
        </div>
        </footer>



        <!-- Bootstrap core JS -->
        <script src="js/bootstrap.bundle.min.js"></script>

        <!-- Core theme JS -->
        <script src="js/scripts.js"></script>


    </body>
</html>
